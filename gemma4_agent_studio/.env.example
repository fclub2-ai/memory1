# ============================================================
# 워드프레스 설정
# ============================================================
# 워드프레스 사이트 URL (끝 슬래시 없이)
WP_URL=https://your-wordpress.com

# 워드프레스 관리자 사용자명
WP_USER=admin

# 애플리케이션 비밀번호
# 생성 방법: 워드프레스 관리자 -> 사용자 -> 프로필 -> 하단 "애플리케이션 비밀번호" 섹션
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ============================================================
# 구글 서치 콘솔 설정 (색인 재요청 자동화 선택 사항)
# ============================================================
# 서치 콘솔에 등록된 사이트 URL (정확히 일치해야 함)
GSC_SITE_URL=https://your-wordpress.com/

# Google OAuth 2.0 서비스 계정 키 파일 경로 (색인 재요청 기능 사용 시)
# Google Cloud Console -> IAM -> 서비스 계정 -> 키 생성 (JSON)
GOOGLE_SERVICE_ACCOUNT_KEY=service_account_key.json

# ============================================================
# 자동화 설정
# ============================================================
# URL 처리 사이 대기 시간 (초) — Ollama 과부하 방지
DELAY_SECONDS=30

# 리라이팅 대상 최소 글자 수 (이 이하면 무조건 리라이팅)
MIN_CHAR_COUNT=500

# Dry-Run 모드 (true: 실제 업데이트 안 함, false: 실제 반영)
DRY_RUN=false
